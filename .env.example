# DSS150P Lab 4 - environment template
# Copy this file to .env and edit the values. Never commit .env.

# Source dataset location (relative to the project root)
SOURCE_FILE_PATH=data/source/dataset.csv

# Reproducibility
RANDOM_SEED=42

# PostgreSQL connection (placeholders only, choose your own password in .env)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=repro_db
POSTGRES_USER=repro_user
POSTGRES_PASSWORD=change_me